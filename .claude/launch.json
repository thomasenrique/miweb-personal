{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765"],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set MODO_DEMO=1&& npm --prefix web run dev"],
      "port": 3001
    }
  ]
}
